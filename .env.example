NODE_ENV=development
HOST=127.0.0.1
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27018/marketplace_dev?replicaSet=marketplace-rs
FRONTEND_URL=http://localhost:3000
# Generate locally: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-48-characters

# local saves private email previews under the project work/mail directory.
# SMTP is mandatory in production. Real credentials belong only in .env.
MAIL_MODE=local
# MAIL_FROM=noreply@your-domain.example
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# Port 465 usually requires SMTP_SECURE=true; 587 uses mandatory STARTTLS.

# Optional Stripe TEST payments. Both values are required to enable checkout.
# Obtain sk_test_ credentials from Stripe Dashboard; never use live keys.
# stripe listen --forward-to localhost:4000/api/payments/stripe/webhook
# Copy the CLI listener's whsec_ signing secret into your private .env.
# STRIPE_SECRET_KEY=sk_test_replace_with_your_test_key
# STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_listener_secret
